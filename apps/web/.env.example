# Copy to apps/web/.env.local (never commit it). Values here are placeholders only.
PORT=3001

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
HARNESSROUTER_URL=
HARNESSROUTER_KEY=
TOKENROUTER_KEY=

# MCP server for agents (/api/mcp, packages/tools/README.md)
MCP_BEARER_TOKEN=
AGENT_RO_DATABASE_URL=postgres://agent_ro:PASSWORD@HOST:5432/DBNAME
CLAIM_WRITER_DATABASE_URL=postgres://claim_writer:PASSWORD@HOST:5432/DBNAME

# Private investigation runtime (agents/README.md). Harness IDs come from agents/harnessrouter.json.
HR_API_KEY=
HR_SCOPE_HARNESS_ID=
HR_MEASURE_HARNESS_ID=
HR_BILL_HARNESS_ID=
HR_FOOTPRINT_HARNESS_ID=
HR_INTERESTS_HARNESS_ID=
HR_GENERAL_HARNESS_ID=
# Ask agent with web search plus Aletheia records (agents/README.md). Falls back to HR_GENERAL_HARNESS_ID when unset.
HR_ASK_HARNESS_ID=
INVESTIGATION_DATABASE_URL=
INVESTIGATIONS_RUNTIME_READY=0

# Private email identity: disabled until a human provisions the generated schema,
# dedicated roles, verified sender domain, and credentials. No owner URL fallback.
AUTH_EMAIL_ENABLED=false
AUTH_SENDER_VERIFIED=false
AUTH_DATABASE_URL=postgres://auth_server:PASSWORD@HOST:5432/DBNAME
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
AUTH_TEAM_EMAILS=
AUTH_EMAIL_FROM=
RESEND_API_KEY=
EVENT_WRITER_DATABASE_URL=postgres://event_writer:PASSWORD@HOST:5432/DBNAME
GAME_READER_DATABASE_URL=postgres://game_reader:PASSWORD@HOST:5432/DBNAME

# Admin addresses are a separate exact two-address allowlist (P15).
ADMIN_EMAILS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Team sign-in (used while PUBLIC_SITE is off). Both are required; without them
# nobody can sign in. TEAM_SESSION_SECRET must be at least 32 characters, e.g.
# `openssl rand -base64 48`. Changing either value signs everyone out.
TEAM_PASSWORD=
TEAM_SESSION_SECRET=

# Feature flags (see src/lib/flags.ts). All default off except SHOW_INDIVIDUAL_DONORS.
# Keep PUBLIC_SITE off: every page requires team sign-in.
PUBLIC_SITE=false
PUBLIC_SIGNUP=false
SHOW_INDIVIDUAL_DONORS=true
CARDS_PUBLIC=false
PAYMENTS_ENABLED=false
PRICING_MODE=monthly        # monthly | single
BLOCK_COMMITTEE_DOMAINS=false
CAMPUS_LABELS=names         # names | nicknames
CAMPUS_GAME=false
LOCAL_FILERS=false
FORM700=false

# Open test site: skips team sign-in on every page (hosted testing only). Admin-only actions still need a verified admin.
OPEN_TESTING=false

# Voter-interview prototype (src/app/interview). Local preview only; opens /interview without sign-in.
INTERVIEW_PREVIEW=false
INTERVIEW_DATABASE_URL=postgres://interview_app:PASSWORD@HOST:5432/DBNAME
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-live-1
# Only for gpt-realtime* models:
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Backend model GPT-Live delegates tool calls to:
OPENAI_DELEGATE_MODEL=gpt-5.6-terra
# Signs the cookie that marks which interviews this browser started (32+ characters). Falls back to TEAM_SESSION_SECRET.
INTERVIEW_COOKIE_SECRET=
# Required by /api/interview/cron outside development.
CRON_SECRET=
