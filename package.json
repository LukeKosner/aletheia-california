{
  "name": "aletheia",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun --filter @aletheia/web dev",
    "build": "bun --filter @aletheia/web build",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test",
    "check:colors": "bun scripts/check-colors.ts",
    "check:buildlog": "bun scripts/check-buildlog.ts",
    "db:generate": "bun --filter @aletheia/db generate",
    "db:push": "bun --filter @aletheia/db push"
  }
}
