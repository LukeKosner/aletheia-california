# Deployment owner confirms the intended sponsor host, account catalog and actual writer/verifier routing.
# No remote call is allowed until all three are 1. Never retrieve or print secrets as an agent.
VERIFIER_HOST_CONFIRMED=0
VERIFIER_CATALOG_CONFIRMED=0
VERIFIER_ROUTING_READY=0
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=
# Copy the exact account-supported model ID. There is deliberately no default verifier model.
VERIFIER_MODEL=
VERIFIER_MODEL_FAMILY=
# Must match the actual configured P9 HarnessRouter writer. Reconfirm if the harness changes.
WRITER_MODEL=openai/gpt-5.6-sol
WRITER_MODEL_FAMILY=gpt
